# Created automatically when a Neon database is connected in Vercel.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Comma-separated application usernames with global administration access.
SUPERADMIN_USERNAMES=boza

# Optional local-only test accounts: boza, dos and tres.
# Never enabled when NODE_ENV=production, even if configured by mistake.
DEV_SEED_USERS=false
DEV_SEED_PASSWORD=test1234
